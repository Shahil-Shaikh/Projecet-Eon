{\pard \ql \f0 \sa180 \li0 \fi0 {\b Installed Locations:} - {\f1 /usr/local/bin/rpicam-*} - Camera binaries - {\f1 /usr/local/lib/libcamera*.so} - libcamera libraries - {\f1 /usr/local/share/libcamera/ipa/} - IPA modules & tuning files\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Device Nodes:} - {\f1 /dev/video*} - Video devices - {\f1 /dev/media*} - Media controller devices - {\f1 /dev/dma_heap/} - DMA heap devices\par}
