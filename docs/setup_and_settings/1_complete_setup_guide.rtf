{\pard \ql \f0 \sa180 \li0 \fi0 \outlinelevel2 \b \fs28 File Locations\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b Configuration Files:} - {\f1 /boot/firmware/config.txt} - Boot configuration - {\f1 /etc/udev/rules.d/99-dma-heap.rules} - DMA permissions\par}
