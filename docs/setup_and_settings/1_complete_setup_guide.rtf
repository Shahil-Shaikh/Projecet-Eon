{\pard \ql \f0 \sa180 \li0 \fi0 {\b System Checks:}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 # Check CMA memory\line
sudo dmesg | grep cma\line
\line
# Check video group\line
groups\line
\line
# Check DMA heap permissions\line
ls -l /dev/dma_heap/\line
\line
# Camera detection\line
sudo dmesg | grep imx708\line
sudo dmesg | grep arducam\line
\line
# List video devices\line
v4l2-ctl --list-devices\par}
{\pard \ql \f0 \sa180 \li0 \fi0 {\b After Configuration Changes:}\par}
{\pard \ql \f0 \sa180 \li0 \fi0 \f1 # After editing config.txt\line
